<?xml version="1.0" encoding="utf-8"?><!--
    Раздел «Дополнительные функции»: один ключ активации на все платные возможности.
    Здесь же объясняем, что именно он открывает, — на самих экранах функций для этого нет места.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_title_pro_section">

    <PreferenceCategory
        android:layout="@layout/preference_category_custom_top"
        android:title="@string/pref_title_pro_activation">

        <Preference
            android:key="pro.status"
            android:layout="@layout/preference_custom"
            android:selectable="false"
            android:title="@string/pref_title_pro_status"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pro.member_id"
            android:layout="@layout/preference_custom"
            android:title="@string/pref_title_pro_member_id"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pro.enter_key"
            android:layout="@layout/preference_custom"
            android:summary="@string/pref_summary_pro_enter_key"
            android:title="@string/pref_title_pro_enter_key"
            app:iconSpaceReserved="false" />

        <!--
            Удаление ключа — с обязательным подтверждением (пункт стоит рядом с вводом, случайный
            тап не должен лишать оплаченного). Нужен потому, что «ключ активен» и «push работает» —
            разные вещи: push держится ещё и на сессии входа, которая может протухнуть. Снять ключ и
            ввести заново — чистый способ пройти активацию push с нуля.
        -->
        <Preference
            android:key="pro.remove_key"
            android:layout="@layout/preference_custom"
            android:summary="@string/pref_summary_pro_remove_key"
            android:title="@string/pref_title_pro_remove_key"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_custom"
        android:title="@string/pref_title_pro_features">

        <Preference
            android:key="pro.feature.push"
            android:layout="@layout/preference_custom"
            android:selectable="false"
            android:summary="@string/pref_summary_pro_feature_push"
            android:title="@string/pref_title_pro_feature_push"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="pro.feature.proxy"
            android:layout="@layout/preference_custom"
            android:selectable="false"
            android:summary="@string/pref_summary_pro_feature_proxy"
            android:title="@string/pref_title_pro_feature_proxy"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/preference_category_custom"
        android:title="@string/pref_title_pro_how">

        <Preference
            android:key="pro.how"
            android:layout="@layout/preference_custom"
            android:selectable="false"
            android:summary="@string/pref_summary_pro_how"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
