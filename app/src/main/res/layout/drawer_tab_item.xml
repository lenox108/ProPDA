<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/drawer_item_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp56"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp12"
        android:paddingEnd="@dimen/dp0">

        <!-- Отступ уровня и линия связи — режим дерева переходов; в плоском списке скрыты. -->
        <Space
            android:id="@+id/drawer_item_indent"
            android:layout_width="@dimen/dp0"
            android:layout_height="@dimen/dp1" />

        <View
            android:id="@+id/drawer_item_tree_line"
            android:layout_width="@dimen/dp1"
            android:layout_height="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp8"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drawer_item_icon"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:layout_marginEnd="@dimen/dp12"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_forum"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="@dimen/dp0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp8"
            android:paddingTop="@dimen/dp8">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/drawer_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/list_topic_meta_text_size"
                tools:text="@string/test_drawer_item_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/drawer_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/list_section_header_text_size"
                android:visibility="gone"
                tools:text="Тема · стр. 4218"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drawer_item_pin"
            android:layout_width="@dimen/dp16"
            android:layout_height="@dimen/dp16"
            android:layout_marginEnd="@dimen/dp8"
            android:contentDescription="@string/tab_menu_pin"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_pin"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drawer_item_close"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/tab_menu_close"
            android:focusable="true"
            android:padding="@dimen/dp12"
            app:srcCompat="@drawable/ic_clear"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Ручка ручной сортировки: видна только в режиме «Переместить», вместо крестика. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drawer_item_drag"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"
            android:contentDescription="@string/tab_menu_reorder"
            android:padding="@dimen/dp12"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_drag_handle"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
