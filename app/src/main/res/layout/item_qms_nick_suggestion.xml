<?xml version="1.0" encoding="utf-8"?>
<!-- Пункт выпадающего списка ников: simple_dropdown_item_1line берёт системные цвета
     и на тёмной палитре выглядит инородно. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="@dimen/content_padding_horizontal"
    android:paddingEnd="@dimen/content_padding_horizontal"
    android:singleLine="true"
    android:textAppearance="?attr/textAppearanceBodyLarge"
    android:textColor="?attr/colorOnSurface" />
