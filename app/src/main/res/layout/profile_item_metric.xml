<?xml version="1.0" encoding="utf-8"?>
<!-- Одна метрика профиля (значение + подпись). Ширина задаётся весом из кода. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp12"
    android:paddingBottom="@dimen/dp12">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/profile_stat_value_text_size"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/content_spacing_half"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/list_topic_meta_text_size" />
</LinearLayout>
