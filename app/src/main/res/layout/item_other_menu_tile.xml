<?xml version="1.0" encoding="utf-8"?><!--
    Плитка меню: круглая иконка и подпись под ней. Карточка-обёртка осталась (её рамку
    подсвечивает режим редактирования), но в обычном виде она прозрачная и без обводки —
    вес плитке даёт кружок иконки, а не плашка во всю ячейку.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/other_menu_tile_height"
    android:minHeight="@dimen/other_menu_tile_height"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/dp4"
        android:paddingEnd="@dimen/dp4"
        android:paddingTop="@dimen/dp6"
        android:paddingBottom="@dimen/dp6">

        <FrameLayout
            android:id="@+id/otherMenuIconHolder"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:background="@drawable/bg_menu_tile_icon"
            app:layout_constraintBottom_toTopOf="@+id/otherMenuTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/otherMenuIcon"
                android:layout_width="@dimen/dp24"
                android:layout_height="@dimen/dp24"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="?attr/menu_tile_icon"
                tools:src="@drawable/ic_star" />
        </FrameLayout>

        <TextView
            android:id="@+id/otherMenuTitle"
            android:layout_width="0dp"
            android:layout_height="@dimen/other_menu_tile_title_height"
            android:layout_marginTop="@dimen/dp4"
            android:ellipsize="end"
            android:gravity="center_horizontal|top"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/otherMenuIconHolder"
            tools:text="Избранное" />

        <ImageView
            android:id="@+id/otherMenuRemove"
            android:layout_width="@dimen/dp20"
            android:layout_height="@dimen/dp20"
            android:contentDescription="@string/other_menu_remove_shortcut"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="?attr/colorAccent"
            app:layout_constraintStart_toStartOf="@+id/otherMenuIconHolder"
            app:layout_constraintTop_toTopOf="@+id/otherMenuIconHolder"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/otherMenuCounter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/bottom_tab_badge_min_height"
            android:background="?attr/count_background"
            android:gravity="center"
            android:minWidth="@dimen/bottom_tab_badge_min_width"
            android:paddingStart="@dimen/bottom_tab_badge_padding_horizontal"
            android:paddingEnd="@dimen/bottom_tab_badge_padding_horizontal"
            android:textColor="@android:color/white"
            android:textSize="@dimen/attachment_error_text_size"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/otherMenuIconHolder"
            app:layout_constraintTop_toTopOf="@+id/otherMenuIconHolder"
            tools:text="22"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
