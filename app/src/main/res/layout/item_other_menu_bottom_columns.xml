<?xml version="1.0" encoding="utf-8"?><!--
    Сколько мест в нижней панели — прямо под её слотами в режиме редактирования: менять
    состав панели и её размер логично в одном месте.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/content_padding_horizontal"
    android:paddingTop="@dimen/dp8"
    android:paddingEnd="@dimen/content_padding_horizontal"
    android:paddingBottom="@dimen/dp4">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/pref_title_bottom_nav_columns"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/list_topic_meta_text_size" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/otherBottomColumnsGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/otherBottomColumns5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/other_menu_bottom_columns_5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/otherBottomColumns6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/other_menu_bottom_columns_6" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
