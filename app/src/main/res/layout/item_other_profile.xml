<?xml version="1.0" encoding="utf-8"?><!--
    Строка профиля в меню: ник с ярлыком группы, под ними репутация и число сообщений
    с иконками. Карандаш справа открывает режим настройки меню; когда статистики нет
    (гость, офлайн, парсер не нашёл полей) — вместо неё обычная подпись.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/list_plate_stroke_color"
    app:strokeWidth="?attr/list_plate_stroke_width">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp64"
        android:paddingBottom="@dimen/dp12"
        android:paddingEnd="@dimen/content_padding_horizontal"
        android:paddingStart="@dimen/content_padding_horizontal"
        android:paddingTop="@dimen/dp12">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileAvatar"
            android:layout_width="@dimen/dp48"
            android:layout_height="@dimen/dp48"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

        <!-- Ник и ярлык группы — цепочка, прижатая влево: чип стоит вплотную к нику,
             а длинный ник сжимается многоточием, а не выталкивает чип за край. -->
        <TextView
            android:id="@+id/profileNick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/content_padding_horizontal"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/list_topic_title_text_size"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/profileDesc"
            app:layout_constraintEnd_toStartOf="@+id/profileGroup"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/profileAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="claude.test" />

        <TextView
            android:id="@+id/profileGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp8"
            android:background="@drawable/bg_profile_group_chip"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/dp8"
            android:paddingTop="@dimen/dp2"
            android:paddingEnd="@dimen/dp8"
            android:paddingBottom="@dimen/dp2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/attachment_error_text_size"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/profileNick"
            app:layout_constraintEnd_toStartOf="@+id/profileEnd"
            app:layout_constraintStart_toEndOf="@+id/profileNick"
            app:layout_constraintTop_toTopOf="@+id/profileNick"
            tools:text="Участник"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/profileDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/list_topic_meta_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/profileEnd"
            app:layout_constraintStart_toStartOf="@+id/profileNick"
            app:layout_constraintTop_toBottomOf="@+id/profileNick"
            tools:text="Перейти в профиль" />

        <LinearLayout
            android:id="@+id/profileStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/profileDesc"
            app:layout_constraintStart_toStartOf="@+id/profileNick"
            app:layout_constraintTop_toTopOf="@+id/profileDesc"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_star"
                app:tint="?attr/colorAccent" />

            <TextView
                android:id="@+id/profileReputation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/list_topic_meta_text_size"
                tools:text="12" />

            <TextView
                android:id="@+id/profileStatsSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp8"
                android:layout_marginEnd="@dimen/dp8"
                android:text="@string/other_menu_profile_stats_separator"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/list_topic_meta_text_size" />

            <ImageView
                android:id="@+id/profilePostsIcon"
                android:layout_width="@dimen/dp16"
                android:layout_height="@dimen/dp16"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_comment"
                app:tint="?attr/colorAccent" />

            <TextView
                android:id="@+id/profilePosts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp4"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/list_topic_meta_text_size"
                tools:text="348" />
        </LinearLayout>

        <ImageView
            android:id="@+id/profileEnd"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/other_menu_edit_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_profile_toolbar_create"
            app:tint="?attr/icon_base" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
