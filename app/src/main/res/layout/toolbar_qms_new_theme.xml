<?xml version="1.0" encoding="utf-8"?>
<!--
    Форма создания новой темы QMS. Живёт в toolbar_content-стабе, поэтому фон совпадает
    с тулбаром (main_toolbar_accent_surface) — иначе под шапкой видна полоса другого тона.
    Поля — M3 OutlinedBox с плавающими подписями: у них нормальные внутренние отступы
    (у голого TextInputLayout без стиля текст прилипал к рамке).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/main_toolbar_accent_surface"
    android:orientation="vertical"
    android:paddingBottom="@dimen/content_block_padding_vertical"
    android:paddingEnd="@dimen/content_padding_horizontal"
    android:paddingStart="@dimen/content_padding_horizontal"
    android:paddingTop="@dimen/content_spacing"
    android:animateLayoutChanges="true">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/qms_theme_nick_block"
        style="@style/Widget.ForPDA.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/user_nick"
        app:boxStrokeColor="@color/qms_textfield_stroke"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ForPDA.Small"
        app:startIconDrawable="@drawable/ic_account_circle"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/qms_theme_nick_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/qms_theme_title_block"
        style="@style/Widget.ForPDA.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_spacing"
        android:hint="@string/theme"
        app:boxStrokeColor="@color/qms_textfield_stroke"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:counterEnabled="false"
        app:hintTextColor="?attr/colorOnSurfaceVariant"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ForPDA.Small"
        app:startIconDrawable="@drawable/ic_qms_theme_title"
        app:startIconTint="?attr/colorOnSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/qms_theme_title_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
