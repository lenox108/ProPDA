<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_panel_quick_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_message_panel_quick"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp2">

    <ScrollView
        android:id="@+id/message_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:minHeight="@dimen/dp56"
        android:scrollbars="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <forpdateam.ru.forpda.ui.views.CodeEditor
                android:id="@+id/message_field"
                style="@style/Widget.ForPDA.CodeEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/msg_panel_hint_message"
                android:imeOptions="flagNoFullscreen"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="@dimen/dp40"
                android:paddingBottom="@dimen/dp0"
                android:paddingEnd="@dimen/content_padding_horizontal"
                android:paddingStart="@dimen/content_padding_horizontal"
                android:paddingTop="@dimen/content_spacing"
                android:textSize="@dimen/list_topic_title_text_size" />
        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp48"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_attachments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/attachments"
                app:srcCompat="@drawable/ic_attachment" />

            <TextView
                android:id="@+id/attachment_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/content_spacing"
                android:layout_marginEnd="@dimen/content_spacing_half"
                android:background="@drawable/notify_dot_menu"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:minWidth="@dimen/dp16"
                android:minHeight="@dimen/dp16"
                android:paddingStart="@dimen/content_spacing_half"
                android:paddingEnd="@dimen/content_spacing_half"
                android:textColor="@color/white"
                android:textSize="@dimen/news_list_compat_meta_text_size"
                android:visibility="gone" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_full"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/full_form"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_fullscreen" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_hide"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hide_form"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_transcribe_close" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_advanced_input"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/codes_and_smiles"
            app:srcCompat="@drawable/ic_format_tools" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_clear_message"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/msg_panel_clear_message"
            app:srcCompat="@drawable/ic_clear" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_preview"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/msg_panel_preview"
            app:srcCompat="@drawable/ic_visibility" />

        <FrameLayout
            android:id="@+id/send_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp48"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/button_send"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/send_message"
                app:srcCompat="@drawable/ic_send" />

            <ProgressBar
                android:id="@+id/send_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:contentDescription="@string/send_message"
                android:padding="@dimen/dp8"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
