<?xml version="1.0" encoding="utf-8"?>
<!--
    Чип одного устройства из профиля. Assist-чип, а не Filter: состояния
    «выбрано» тут нет, тап просто открывает страницу устройства в DevDB.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Assist"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:textColor="?attr/colorOnSurface"
    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:chipIconTint="?attr/colorPrimary"
    app:chipIconVisible="true"
    app:chipStrokeWidth="0dp"
    app:ensureMinTouchTargetSize="false" />
