<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp4"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="@dimen/dp12"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/divider_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <forpdateam.ru.forpda.ui.views.messagepanel.attachments.SquareRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drawer_item_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/background_for_lists"
                android:clickable="false"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/overlay_and_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/attachment_overlay_bg"
                android:clickable="false"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="@dimen/dp48"
                android:layout_height="@dimen/dp48"
                android:layout_centerInParent="true"
                android:clickable="false"
                android:indeterminate="false"
                android:visibility="gone"
                app:indicatorColor="?attr/colorAccent"
                app:trackColor="?attr/colorAccent"
                app:trackThickness="@dimen/dp2"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/progress_value"
                android:layout_width="@dimen/dp48"
                android:layout_height="@dimen/dp48"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textColor="?colorAccent"
                android:textSize="@dimen/list_section_header_text_size"
                android:visibility="gone"
                tools:text="100%"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/reload"
                android:layout_width="@dimen/dp48"
                android:layout_height="@dimen/dp48"
                android:layout_centerInParent="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/retry"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_toolbar_refresh" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/radio_button"
                android:layout_width="@dimen/dp48"
                android:layout_height="@dimen/dp48"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:clickable="false" />
        </forpdateam.ru.forpda.ui.views.messagepanel.attachments.SquareRelativeLayout>

        <LinearLayout
            android:id="@+id/file_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp12"
            android:paddingTop="@dimen/dp8"
            android:paddingEnd="@dimen/dp12">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="forum-screen-87526.jpg" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/file_attributes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="JPG · 480 КБ" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorAccent"
                android:textSize="@dimen/attachment_error_text_size"
                android:visibility="gone"
                tools:text="Ошибка загрузки. Нажмите повторить." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp4"
            android:paddingEnd="@dimen/dp4"
            android:paddingBottom="@dimen/dp4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/insert_attachment"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="@dimen/dp40"
                android:text="@string/insert"
                android:textColor="?attr/colorAccent"
                app:rippleColor="?attr/colorAccent" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/more_actions"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/attachment_actions"
                app:srcCompat="@drawable/ic_more_vert" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
