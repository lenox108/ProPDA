<?xml version="1.0" encoding="utf-8"?>
<!--
    Панель написания комментария к новости.

    Цвета НЕ берутся из темы окна диалога: BottomSheetDialog инфлейтится с
    `bottomSheetDialogTheme` (полная тема DayNightAppTheme.BottomSheetDialog),
    которая накладывается поверх темы активити с force=true и жёстко пинит
    colorSurface = @color/light_colorPrimary. Под Material You colorPrimary —
    это ДИНАМИЧЕСКИЙ акцент обоев, поэтому панель заливалась коричневым/цветным
    слэбом. Итоговые цвета проставляет NewsCommentComposeBottomSheet.applyComposePanelTheme()
    из темы АКТИВИТИ (M3-роли: colorSurface / colorSurfaceContainerHigh /
    colorOnSurface / colorAccent). Значения ниже — только превью и статический
    фолбэк.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp16"
    android:paddingEnd="@dimen/dp16"
    android:paddingBottom="@dimen/dp12">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/write"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_hide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_arrow_down"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <EditText
        android:id="@+id/message_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:autofillHints="message"
        android:gravity="top"
        android:hint="@string/chat_creator_enter_message"
        android:imeOptions="flagNoFullscreen"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="10"
        android:minLines="3"
        android:padding="@dimen/dp12"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/list_topic_title_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/send_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp8"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorAccent"
            app:indicatorSize="20dp"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_send"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send"
            android:textColor="?attr/colorAccent"
            app:icon="@drawable/ic_send"
            app:iconPadding="@dimen/dp8"
            app:iconTint="?attr/colorAccent" />
    </LinearLayout>

</LinearLayout>
